# Normalise to LF in the repository. Without this, every file committed from
# this Windows box lands with CRLF and later diffs from a Linux CI runner show
# every line as changed.
* text=auto eol=lf

# Binary — never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# Generated; collapse in review.
pnpm-lock.yaml linguist-generated=true -diff
packages/db/drizzle/meta/*.json linguist-generated=true -diff
