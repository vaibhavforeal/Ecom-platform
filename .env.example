# ─────────────────────────────────────────────────────────────
# Copy to .env and adjust. Never commit .env.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Database ────────────────────────────────────────────────
# TWO ROLES, DELIBERATELY. See PLATFORM_BLUEPRINT.md §2.1.
#
#   app_migrator : owns the schema, BYPASSRLS. Migrations only.
#   app_user     : owns nothing, subject to FORCE ROW LEVEL SECURITY.
#                  Every web + worker request uses this.
#
# app_user connects through PgBouncer (port 6432) in transaction
# pooling mode. This is why tenant context uses SET LOCAL only.
DATABASE_URL_APP=postgres://app_user:app_user_dev_pw@localhost:6442/platform
DATABASE_URL_MIGRATOR=postgres://app_migrator:app_migrator_dev_pw@localhost:5442/platform

# Direct (non-pooled) app connection. Used only by the isolation
# test suite, which needs to assert PgBouncer-independent behaviour.
DATABASE_URL_APP_DIRECT=postgres://app_user:app_user_dev_pw@localhost:5442/platform

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6389

# ── Secrets ─────────────────────────────────────────────────
# Generate with:  openssl rand -hex 32
OTP_PEPPER=dev_only_change_me_0000000000000000000000000000000000000000000000000000
SESSION_SECRET=dev_only_change_me_1111111111111111111111111111111111111111111111111111

# ── Domains ─────────────────────────────────────────────────
# The platform's own domain (console lives here).
PLATFORM_DOMAIN=localhost:3001
CONSOLE_ORIGIN=http://localhost:3001

# Tenants get <slug>.STOREFRONT_ROOT_DOMAIN for free, plus any
# verified custom domain. In dev, *.localhost resolves to 127.0.0.1
# in Chrome/Firefox/Safari with no hosts-file edits, so you can hit
# http://acme.localhost:3000 and http://globex.localhost:3000
# immediately after seeding.
STOREFRONT_ROOT_DOMAIN=localhost:3000

# ── OTP delivery ────────────────────────────────────────────
# Phase 0 ships a console-logging provider. Phase 4 swaps in MSG91
# (requires TRAI DLT registration — start that now, it takes weeks).
OTP_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_DLT_TEMPLATE_ID=

# ── Caddy on-demand TLS ─────────────────────────────────────
# Shared secret Caddy presents to /api/internal/verify-domain so
# only the proxy can drive certificate issuance decisions.
INTERNAL_API_SECRET=dev_only_change_me_2222222222222222222222222222222222222222222222222222

# Master key for envelope-encrypting tenant-held third-party credentials
# (carrier API keys, gateway secrets). Wraps a per-record data key; the
# database never sees it, so a dump alone yields nothing.
#   Generate with:  openssl rand -base64 32
# Rotating this requires rewrapping every carrier_accounts row — there is
# a script for it, but plan the rotation, do not improvise it.
CREDENTIALS_MASTER_KEY=REPLACE_ME_openssl_rand_base64_32_AAAAAAAAAAAAAAAAAAAAAAA=

# Custom-domain DNS targets checked by the domain verification job.
CUSTOM_DOMAIN_CNAME_TARGET=domains.platform.in
CUSTOM_DOMAIN_A_RECORDS=

# Public base URL for product media (object storage / CDN).
#
# Media rows store an object-storage KEY, never a URL, so this can change
# between environments without a data migration. Left unset, image URLs are
# site-relative — fine locally, but JSON-LD needs absolutes, so set this on
# any host a crawler can reach. Production points at R2 behind Cloudflare
# (blueprint 8.1: zero egress, which matters when serving product images).
MEDIA_PUBLIC_BASE_URL=
